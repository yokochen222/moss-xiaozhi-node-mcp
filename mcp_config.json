{
  "mcpServers": {
    "yo-onvif-mcp": {
      "command": "npx",
      "disabled": true,
      "args": ["yo-onvif-mcp"],
      "env": {
        "ONVIF_USERNAME": "admin",
        "ONVIF_PASSWORD": "admin123",
        "ONVIF_XADDR": "http://192.168.31.10:80/onvif/device_service"
      }
    },
    "yo-execute-shortcuts-mcp": {
      "disabled": true,
      "command": "npx",
      "args": ["yo-execute-shortcuts-mcp", "--config", "yo-execute-shortcuts-mcp.json"]
    },
    "aisearch-mcp-server": {
      "type": "streamableHttp",
      "description": "搜索实时信息，支持使用大模型进行总结回复。",
      "url": "https://qianfan.baidubce.com/v2/ai_search/mcp",
      "headers": {
        "Authorization": "Bearer "
      }
    }
  }
}
